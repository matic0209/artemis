# DeFi Analyzer Environment Variables
# Copy this file to .env and fill in your values

# Network Configuration
DEFI_ANALYZER_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEFI_ANALYZER_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEFI_ANALYZER_CHAIN_ID=1

# Database Configuration
DEFI_ANALYZER_DATABASE_URL=postgresql://postgres:password@localhost:5432/defi_analyzer

# Security Configuration
DEFI_ANALYZER_API_KEY=your-secret-api-key-here

# Monitoring Configuration
DEFI_ANALYZER_LOG_LEVEL=info
DEFI_ANALYZER_ALERTING_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# JIT Strategy Configuration
DEFI_ANALYZER_TARGET_MIN=5000000000000000  # 0.005 ETH in wei
DEFI_ANALYZER_TIME_BUDGET_MS=500

# Performance Configuration
DEFI_ANALYZER_MAX_CONCURRENT=10
DEFI_ANALYZER_MEMORY_LIMIT_MB=2048

# Optional: Flashbots Configuration
FLASHBOTS_AUTH_KEY=your-flashbots-key
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Optional: MEV-Share Configuration  
MEVSHARE_AUTH_KEY=your-mevshare-key
MEVSHARE_RELAY_URL=https://mev-share.flashbots.net

# Optional: Additional RPC Endpoints
BACKUP_RPC_URL_1=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
BACKUP_RPC_URL_2=https://rpc.ankr.com/eth
