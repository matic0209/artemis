# Artemis 优化版环境配置示例

# === 必需配置 ===
WSS_ENDPOINT=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
OPENSEA_API_KEY=your_opensea_api_key_here
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
ARB_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# === 性能配置 ===
BID_PERCENTAGE=90
BLOCK_BUFFER_SIZE=2048
MEMPOOL_BUFFER_SIZE=4096

# === rbuilder 高级优化（可选）===
ENABLE_RBUILDER=false
RBUILDER_URL=http://localhost:8645
RBUILDER_ALGORITHM=max-profit

# === 监控配置 ===
ARTEMIS_METRICS_ADDR=127.0.0.1:9898
RUST_LOG=artemis_core=info,artemis=info

# === 过滤配置 ===
MIN_TX_VALUE=100000000000000000
